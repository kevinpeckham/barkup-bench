# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# ----------
#
# barkup-bench calls models through the Vercel AI Gateway. The key lives in
# .env.local (gitignored — never commit env files).

# @required @sensitive
AI_GATEWAY_API_KEY=

# Study AW (docs/BRIEF-AW.md): a Turso API token scoped to a SANDBOX
# organization/group — the runner creates and destroys throwaway aw-fk-*
# databases there and refuses to start without all three.
# @optional @sensitive
TURSO_API_TOKEN=
# @optional
TURSO_SANDBOX_ORG=
# @optional
TURSO_SANDBOX_GROUP=

# Dedicated revocable token for the fk-watch CI probe (GitHub secret
# source; `turso auth api-tokens revoke fk-watch` kills it independently).
# @optional @sensitive
TURSO_WATCH_TOKEN=
